      "id": 1,
      "title": "RAG Requests Over Time",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "repomind-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "repomind-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at, 1m) AS time, COUNT(*) as value FROM rag_events WHERE $__timeFilter(created_at) GROUP BY time ORDER BY time",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "title": "Average Total Latency (ms)",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "repomind-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "repomind-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT AVG(total_latency_ms) as value FROM rag_events WHERE $__timeFilter(created_at)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "title": "Response Time Over Time (Retrieval vs Generation)",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "repomind-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "repomind-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at, 1m) AS time, AVG(retrieval_latency_ms) as retrieval, AVG(generation_latency_ms) as generation FROM rag_events WHERE $__timeFilter(created_at) GROUP BY time ORDER BY time",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "title": "Token Usage (Input / Output / Total)",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "repomind-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "repomind-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at, 1m) AS time, AVG(input_tokens) as input, AVG(output_tokens) as output, AVG(total_tokens) as total FROM rag_events WHERE $__timeFilter(created_at) GROUP BY time ORDER BY time",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "title": "Model Used",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "repomind-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "repomind-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT llm_model, COUNT(*) as count FROM rag_events WHERE $__timeFilter(created_at) GROUP BY llm_model",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 6,
      "title": "User Feedback (+1 / -1)",
      "type": "piechart",
      "datasource": {
        "type": "postgres",
        "uid": "repomind-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "repomind-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT rating, COUNT(*) as count FROM user_feedback WHERE $__timeFilter(created_at) GROUP BY rating",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "id": 7,
      "title": "Error Rate",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "repomind-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "repomind-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (COUNT(CASE WHEN success = false THEN 1 END) * 100.0) / COUNT(*) as error_rate FROM rag_events WHERE $__timeFilter(created_at)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "id": 8,
      "title": "Response Relevance (Rate %)",
      "type": "gauge",
      "datasource": {
        "type": "postgres",
        "uid": "repomind-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "repomind-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (COUNT(CASE WHEN rating = 'positive' THEN 1 END) * 100.0) / NULLIF(COUNT(*), 0) as value FROM user_feedback",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "id": 9,
      "title": "Estimated Cost Over Time ($)",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "repomind-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "repomind-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at, 1m) AS time, SUM(COALESCE(input_tokens, 0) * 0.0000015 + COALESCE(output_tokens, 0) * 0.000002) AS value FROM rag_events WHERE $__timeFilter(created_at) GROUP BY time ORDER BY time",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "id": 10,
      "title": "Last 5 Conversations",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "repomind-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "repomind-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT query AS question, answer, COALESCE((SELECT rating FROM user_feedback WHERE request_id = rag_events.request_id LIMIT 1), 'no feedback') AS relevance, created_at AS timestamp FROM rag_events WHERE success = true ORDER BY created_at DESC LIMIT 5",
          "refId": "A"
        }
      ]
    }
